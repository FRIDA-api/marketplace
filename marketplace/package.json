{
  "name": "marketplace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test:local": "ng test --browsers=Chrome --watch=true",
    "test": "ng test --watch=false --browsers=ChromiumHeadless",
    "serve:ssr:marketplace": "node dist/marketplace/server/server.mjs",
    "e2e:test": "npx playwright test",
    "e2e:report": "npx playwright show-report",
    "e2e:test:ci": "start-server-and-test start http://localhost:4200 e2e:test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.2.1",
    "@angular/cdk": "^20.2.0",
    "@angular/common": "^20.2.1",
    "@angular/compiler": "^20.2.1",
    "@angular/core": "^20.2.1",
    "@angular/forms": "^20.2.1",
    "@angular/material": "^20.2.0",
    "@angular/platform-browser": "^20.2.1",
    "@angular/platform-browser-dynamic": "^20.2.1",
    "@angular/platform-server": "^20.2.1",
    "@angular/router": "^20.2.1",
    "@angular/ssr": "^20.2.0",
    "@ngx-translate/core": "15.0.0",
    "@ngx-translate/http-loader": "8.0.0",
    "express": "5.1.0",
    "immutable": "4.3.7",
    "ng-mocks": "14.13.5",
    "rxjs": "~7.8.0",
    "start-server-and-test": "^2.0.3",
    "swagger-ui": "5.27.1",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.2.0",
    "@angular/cli": "^20.2.0",
    "@angular/compiler-cli": "^20.2.1",
    "@playwright/test": "1.55.0",
    "@types/express": "5.0.3",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.19.22",
    "@types/swagger-ui": "^3.52.4",
    "jasmine-core": "~5.1.0",
    "karma": "6.4.3",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "karma-junit-reporter": "~2.0.1",
    "typescript": "5.8.3"
  }
}
